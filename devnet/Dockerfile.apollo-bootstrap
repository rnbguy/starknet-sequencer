# Simple Dockerfile for bootstrapping apollo_node with dummy L1 provider
FROM rust:1-slim

# Install required system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    ca-certificates \
    git \
    python3 \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy Cargo files first for better caching
COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./

# Copy source code
COPY . .

# Build apollo_node binary with --locked as requested in the requirements
RUN cargo build --locked --bin apollo_node --release

# Expose common ports (RPC and monitoring)
EXPOSE 8080 8081 8082 8545

# Create data directory for mounting
RUN mkdir -p /data

# Copy startup script
COPY devnet/start_devnet.sh /app/start_devnet.sh
RUN chmod +x /app/start_devnet.sh

# Default command to run both L1 provider and apollo_node
CMD ["/app/start_devnet.sh"]